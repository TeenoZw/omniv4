# Omni v4 environment example
#
# Active v4 architecture:
# - Frappe/ERPNext + omni_operations for admin/business engine
# - client-web for public website and customer portal
# - legacy FastAPI settings are kept at the bottom only for v3 reference/migration

# Public/customer domains
OMNI_PUBLIC_SITE_URL=https://www.omnilogistics.co.zw
OMNI_PORTAL_URL=https://www.omnilogistics.co.zw/portal
OMNI_ADMIN_URL=https://admin.omnilogistics.co.zw

# Local Svelte surfaces
OMNI_PUBLIC_PORT=5174
OMNI_PORTAL_PORT=5175
OMNI_PUBLIC_API_URL=http://development.localhost:8000/api/method
OMNI_PORTAL_API_URL=http://development.localhost:8000/api/method

# Svelte build/runtime
VITE_APP_NAME=Omni Logistics
VITE_OMNI_SURFACE=public
VITE_API_URL=http://development.localhost:8000/api/method
VITE_PUBLIC_SITE_URL=http://localhost:5174
VITE_PORTAL_URL=http://localhost:5175/portal
VITE_ADMIN_URL=http://development.localhost:8000

# Frappe/ERPNext local development
FRAPPE_SITE=development.localhost
FRAPPE_BENCH_PATH=erpnext-eval/frappe_docker/development/frappe-bench
FRAPPE_DOCKER_PROJECT=omni-erpnext-eval

# Frappe production reminders
# Store production secrets in Frappe site config, environment secrets, or a secret manager.
# Do not commit real values for these.
OMNI_TELEMATICS_PROVIDER_TOKEN=
OMNI_ZIMRA_DEVICE_ID=
OMNI_ZIMRA_ACTIVATION_KEY=
OMNI_ZIMRA_CERT_PATH=
OMNI_ZIMRA_PRIVATE_KEY_PATH=

# Email / notifications
SMTP_ENABLED=False
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM=
ADMIN_NOTIFY_EMAILS=

# Security / deployment
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175,http://development.localhost:8000

# Legacy v3 reference only
# These values belonged to the old FastAPI/PostgreSQL backend.
# Do not use them for new Omni v4 product work unless v3 is deliberately revived.
LEGACY_V3_DATABASE_URL=postgresql://omni_user:omni_password@127.0.0.1:15432/omni_logistics
LEGACY_V3_API_BASE_URL=http://localhost:8000
LEGACY_V3_VITE_API_URL=http://localhost:8000/api/v1
LEGACY_V3_SECRET_KEY=replace-with-a-strong-64-char-secret-key
