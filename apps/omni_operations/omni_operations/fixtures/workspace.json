  "content": "[{\"id\": \"omni_header_shortcuts\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Omni Command Center</b></span><br><span class=\\\"text-muted\\\">Use the shortcuts below for daily work. Start with New Client Onboarding unless you are receiving stock, preparing a kit, completing an installation, billing, or handling support.</span>\", \"col\": 12}}, {\"id\": \"omni_header_lifecycle\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>What Happens First?</b></span><br><span class=\\\"text-muted\\\">1. Stock trackers and SIMs in Kwekwe or Hwange &nbsp;\\u2192&nbsp; 2. Onboard customer hub &nbsp;\\u2192&nbsp; 3. Capture vehicles &nbsp;\\u2192&nbsp; 4. Prepare or reserve tracker/SIM kit &nbsp;\\u2192&nbsp; 5. Schedule and complete installation &nbsp;\\u2192&nbsp; 6. Link telematics &nbsp;\\u2192&nbsp; 7. Invoice, support, documents and maintenance.</span>\", \"col\": 12}}, {\"id\": \"omni_short_new_client_onboarding\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"New Client Onboarding\", \"col\": 4}}, {\"id\": \"omni_short_prepare_tracker/sim_kit\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Prepare Tracker/SIM Kit\", \"col\": 4}}, {\"id\": \"omni_short_installation_queue\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Installation Queue\", \"col\": 4}}, {\"id\": \"omni_short_customer_fleets\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Customer Fleets\", \"col\": 4}}, {\"id\": \"omni_short_invoices\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Invoices\", \"col\": 4}}, {\"id\": \"omni_short_support_queue\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Support Queue\", \"col\": 4}}, {\"id\": \"omni_spacer\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"omni_header_work\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Work Areas</b></span><br><span class=\\\"text-muted\\\">Each area groups the records a team member needs for one job flow.</span>\", \"col\": 12}}, {\"id\": \"omni_card_1._new_customer\", \"type\": \"card\", \"data\": {\"card_name\": \"1. New Customer\", \"col\": 4}}, {\"id\": \"omni_card_2._customer_setup\", \"type\": \"card\", \"data\": {\"card_name\": \"2. Customer Setup\", \"col\": 4}}, {\"id\": \"omni_card_3._inventory_and_kit_prep\", \"type\": \"card\", \"data\": {\"card_name\": \"3. Inventory and Kit Prep\", \"col\": 4}}, {\"id\": \"omni_card_4._installation_and_field_work\", \"type\": \"card\", \"data\": {\"card_name\": \"4. Installation and Field Work\", \"col\": 4}}, {\"id\": \"omni_card_5._telematics\", \"type\": \"card\", \"data\": {\"card_name\": \"5. Telematics\", \"col\": 4}}, {\"id\": \"omni_card_6._billing_and_customer_care\", \"type\": \"card\", \"data\": {\"card_name\": \"6. Billing and Customer Care\", \"col\": 4}}, {\"id\": \"omni_card_7._purchasing_and_stock_control\", \"type\": \"card\", \"data\": {\"card_name\": \"7. Purchasing and Stock Control\", \"col\": 4}}, {\"id\": \"omni_card_8._fiscalisation\", \"type\": \"card\", \"data\": {\"card_name\": \"8. Fiscalisation\", \"col\": 4}}, {\"id\": \"omni_card_9._administration\", \"type\": \"card\", \"data\": {\"card_name\": \"9. Administration\", \"col\": 4}}]",
